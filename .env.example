# ── Database ────────────────────────────────────────────────
# Neon serverless Postgres connection string (use the "pooled" connection URL).
# For local dev with docker-compose, set DATABASE_URL=postgresql+asyncpg://annotool:annotool@db:5432/annotool
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/dbname?ssl=require

# ── Session signing ─────────────────────────────────────────
# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=change-me-to-something-long-and-random

# ── Google OAuth ────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The redirect URI you registered in Google Cloud Console:
#   https://YOUR-BACKEND.onrender.com/auth/google/callback   (production)
#   http://localhost:8000/auth/google/callback               (local)
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Access control ──────────────────────────────────────────
# Comma-separated list of Google emails allowed to log in.
ALLOWED_EMAILS=you@example.com,employee@example.com
# Single admin email (can see all hours, generate invoices for others, upload images, etc.)
ADMIN_EMAIL=you@example.com

# ── Frontend ────────────────────────────────────────────────
# Public URL of the frontend (used for OAuth post-login redirect + CORS).
FRONTEND_URL=http://localhost:5173

# ── Push token ──────────────────────────────────────────────
# Bearer token the leblanc push script uses to upload comparison images.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PUSH_TOKEN=

# ── Optional: hourly rate default for new users (in cents) ──
DEFAULT_HOURLY_RATE_CENTS=2500
