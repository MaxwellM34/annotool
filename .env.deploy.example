# ╔════════════════════════════════════════════════════════════════════╗
# ║ COPY THIS FILE TO .env.deploy AND FILL IN EVERY VALUE.             ║
# ║ Then run:  bash deploy.sh                                          ║
# ╚════════════════════════════════════════════════════════════════════╝

# ── GitHub repo ─────────────────────────────────────────────────────────
# Owner is your GitHub username/org. The script will `gh repo create` if it
# doesn't already exist, then push current HEAD.
GITHUB_OWNER=
GH_REPO_NAME=annotool

# ── Render service URL ──────────────────────────────────────────────────
# Pick a unique service name. Your URL will be https://<RENDER_SERVICE_NAME>.onrender.com
RENDER_SERVICE_NAME=annotool

# ── Vercel ──────────────────────────────────────────────────────────────
# Project name. Your URL will be https://<VERCEL_PROJECT_NAME>.vercel.app.
# This is the user-facing URL; the Render backend is API-only (proxied via Vercel).
VERCEL_PROJECT_NAME=annotool

# ── Database (Neon, free) ───────────────────────────────────────────────
# 1. Create a project at https://neon.tech (free).
# 2. Copy the POOLED connection string.
# 3. Change the scheme:  postgresql://   →   postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Session signing ─────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# ── Google OAuth ────────────────────────────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized redirect URI:  https://<RENDER_SERVICE_NAME>.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Access control ──────────────────────────────────────────────────────
ALLOWED_EMAILS=you@example.com,employee@example.com
ADMIN_EMAIL=you@example.com

# ── Push token (for the leblanc repo) ───────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PUSH_TOKEN=

# ── Default hourly rate for new users, in cents ─────────────────────────
DEFAULT_HOURLY_RATE_CENTS=2500
