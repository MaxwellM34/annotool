# ╔════════════════════════════════════════════════════════════════════╗
# ║ COPY THIS FILE TO .env.deploy AND FILL IN EVERY VALUE.             ║
# ║ Then run:  bash deploy.sh                                          ║
# ╚════════════════════════════════════════════════════════════════════╝

# ── Fly.io ──────────────────────────────────────────────────────────────
# Pick a globally-unique app name. Your URL will be https://<APP_NAME>.fly.dev
APP_NAME=annotool-yourname
# Region code: iad (US-east), sjc (US-west), lhr (London), syd (Sydney), etc.
FLY_REGION=iad

# ── Database (Neon, free) ───────────────────────────────────────────────
# 1. Create a project at https://neon.tech (free).
# 2. Copy the POOLED connection string from the dashboard.
# 3. Change the scheme:  postgresql://   →   postgresql+asyncpg://
# 4. Keep "?sslmode=require" (or change to "?ssl=require" if asyncpg complains).
DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Session signing ─────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# ── Google OAuth ────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized redirect URI:  https://<APP_NAME>.fly.dev/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Access control ──────────────────────────────────────────────────────
# Comma-separated list of Google emails allowed to sign in.
ALLOWED_EMAILS=you@example.com,employee@example.com
# Single admin email (sees all hours/invoices, can run weekly invoicing).
ADMIN_EMAIL=you@example.com

# ── Push token (for the leblanc repo to upload comparison images) ───────
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PUSH_TOKEN=

# ── Default hourly rate for new users, in cents ─────────────────────────
DEFAULT_HOURLY_RATE_CENTS=2500
